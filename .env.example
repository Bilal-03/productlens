# PostgreSQL (local defaults match docker-compose.yml; migrations/seeding use migration_owner)
# DATABASE_ADMIN_URL is administration-only and should never be deployed to Vercel.
DATABASE_ADMIN_URL=postgresql+psycopg://migration_owner:migration_owner_local@localhost:5432/productlens
APP_DATABASE_URL=postgresql+psycopg://app_writer:app_writer_local@localhost:5432/productlens
ANALYTICS_DATABASE_URL=postgresql+psycopg://analytics_reader:analytics_reader_local@localhost:5432/productlens

# LLM providers. The app remains usable for governed questions without keys.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.7-flash
LLM_FALLBACK_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Public demo controls
FRONTEND_ORIGIN=http://localhost:3000
SESSION_HMAC_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_SECRET=replace-with-a-separate-at-least-32-random-characters-secret

# Optional OIDC/JWKS access boundary. Leave blank to keep the anonymous demo
# and plx1 HMAC gateway mode. OIDC_ROLE_GROUPS is a JSON object; role matching
# is exact and admin > analyst > viewer precedence is applied.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_WORKSPACE_CLAIM=workspace_id
OIDC_GROUPS_CLAIM=groups
OIDC_ROLE_GROUPS={"admin":["productlens-admin"],"analyst":["productlens-analyst"],"viewer":["productlens-viewer"]}
OIDC_JWKS_CACHE_TTL_SECONDS=300
OIDC_JWKS_TIMEOUT_SECONDS=5
# Server-only tenant registry. The workspace key must match the verified
# OIDC workspace_id claim; clients cannot submit or override this mapping.
# Example:
# TENANT_SOURCE_CONFIG={"workspace-acme":{"source_id":"acme-postgres","url_env":"TENANT_ACME_DATABASE_URL"}}
# TENANT_ACME_DATABASE_URL=postgresql+psycopg://analytics_reader:...@warehouse.example.com:5432/productlens
# Optional local-only fallback keyed by source_id. Vercel should resolve
# url_env values from separate server-only variables instead.
TENANT_SOURCE_CONFIG={}
TENANT_SOURCE_URLS={}
SSE_MAX_DURATION_SECONDS=20
SSE_POLL_INTERVAL_SECONDS=5
MULTI_AGENT_ENABLED=true
MULTI_AGENT_TIMEOUT_MS=10000
AI_REQUESTS_PER_SESSION_HOUR=10
AI_REQUESTS_GLOBAL_DAY=100
RESULT_CACHE_TTL_SECONDS=300
QUERY_TIMEOUT_MS=5000
MAX_QUERY_ROWS=5000
PROACTIVE_REPORT_BUDGET_MS=45000
REPORT_PROVIDER_TIMEOUT_MS=2500
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Public Supabase Auth values. Leave blank to keep anonymous demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# One-time Supabase role bootstrap only. Do not deploy DATABASE_SUPERUSER_URL
# or these password variables to Vercel. Set them in a local shell, run
# `make bootstrap-roles`, then configure the three role URLs above.
# DATABASE_SUPERUSER_URL=postgresql+psycopg://postgres:...@db.<project-ref>.supabase.co:5432/postgres
# MIGRATION_OWNER_PASSWORD=use-a-long-random-password
# APP_WRITER_PASSWORD=use-a-long-random-password
# ANALYTICS_READER_PASSWORD=use-a-long-random-password
